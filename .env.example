# TELEGRAM
# Crie um bot com @BotFather no Telegram e cole o token aqui
TELEGRAM_TOKEN=seu_token_do_botfather

# MONGODB
# Local: mongodb://localhost:27017/price_alert_bot
# Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=Cluster0
MONGO_URL=mongodb://localhost:27017/price_alert_bot

# TELEGRAM CHANNEL — se setado, bot posta APENAS no canal (ignora users 1:1).
# Pode ser @username (ex: @achadosmlsp) ou chat_id numerico (ex: -1001234567890).
# Deixar vazio pra modo 1:1 (usuarios individuais que deram /start).
CHANNEL_ID=

# AMAZON AFFILIATE — tag do programa Amazon Associados
AMAZON_ASSOCIATE_TAG=seu-tag-associado

# MERCADO LIVRE AFFILIATE — tag do programa Mercado Livre Afiliados
MERCADOLIVRE_AFFILIATE_TAG=

# MERCADO LIVRE OAuth2 (pendente — API pública passou a exigir credenciais)
# MERCADOLIVRE_CLIENT_ID=
# MERCADOLIVRE_CLIENT_SECRET=

# CADENCIA DO CANAL — dispatcher manda 1 alerta a cada X segundos (default 300 = 5min)
# Alertas ficam na fila, ordenados por maior desconto primeiro. Menor valor = mais msgs no canal.
# ALERT_INTERVAL_SECONDS=300
# ALERT_QUEUE_TTL_HOURS=24  # descarta alerta enfileirado ha mais que isso (oferta velha)

# QUIET HOURS (horario de Brasilia, UTC-3) — dispatcher NAO posta nesse intervalo.
# Fila continua acumulando; envios voltam quando entra na janela ativa.
# Default: silencia 23h-9h (canal so posta 9h-23h BRT). Setar start==end desativa.
# QUIET_HOURS_START_BRT=23
# QUIET_HOURS_END_BRT=9

# ADMIN — chat_id numerico pra receber alertas privados do bot (ex: cookie ML expirou)
# ADMIN_CHAT_ID=

# ========================================================================
# ML COOKIE REFRESHER (opcional) — automatiza renovacao do MERCADOLIVRE_COOKIE
# Watcher local (Playwright + SSH) renova o cookie sem intervencao manual.
# So preencha se for usar ml_cookie_refresher/. Veja o README dessa pasta.
# ========================================================================
# REFRESHER_SSH_HOST=user@1.2.3.4
# REFRESHER_SSH_KEY=C:\caminho\pra\sua_chave_privada
# REFRESHER_REMOTE_ENV=/home/ubuntu/alerta_bot/.env
# REFRESHER_SYSTEMD_UNIT=price-alert-bot
# REFRESHER_FLAG_PATH=/home/ubuntu/alerta_bot/COOKIE_NEEDS_REFRESH
# REFRESHER_POLL_SECONDS=30
