# TELEGRAM
# Crie um bot com @BotFather no Telegram e cole o token aqui
TELEGRAM_TOKEN=seu_token_do_botfather

# MONGODB
# Local: mongodb://localhost:27017/price_alert_bot
# Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=Cluster0
MONGO_URL=mongodb://localhost:27017/price_alert_bot

# TELEGRAM CHANNEL — se setado, bot posta APENAS no canal (ignora users 1:1).
# Pode ser @username (ex: @achadosmlsp) ou chat_id numerico (ex: -1001234567890).
# Deixar vazio pra modo 1:1 (usuarios individuais que deram /start).
CHANNEL_ID=

# AMAZON AFFILIATE — tag do programa Amazon Associados
AMAZON_ASSOCIATE_TAG=seu-tag-associado

# MERCADO LIVRE AFFILIATE — tag do programa Mercado Livre Afiliados
MERCADOLIVRE_AFFILIATE_TAG=

# MERCADO LIVRE OAuth2 (pendente — API pública passou a exigir credenciais)
# MERCADOLIVRE_CLIENT_ID=
# MERCADOLIVRE_CLIENT_SECRET=
