# TELEGRAM
# Crie um bot com @BotFather no Telegram e cole o token aqui
TELEGRAM_TOKEN=seu_token_do_botfather

# MONGODB
# Local: mongodb://localhost:27017/price_alert_bot
# Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=Cluster0
MONGO_URL=mongodb://localhost:27017/price_alert_bot

# AMAZON AFFILIATE
AMAZON_ASSOCIATE_TAG=seu-tag-associado

# MERCADO LIVRE
MERCADOLIVRE_CLIENT_ID=seu_client_id
MERCADOLIVRE_CLIENT_SECRET=seu_client_secret

# SHOPEE
SHOPEE_PARTNER_ID=seu_partner_id
SHOPEE_PARTNER_KEY=sua_partner_key

# WHATSAPP (opcional, para depois)
WHATSAPP_PHONE_NUMBER_ID=seu_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID=seu_business_account_id
WHATSAPP_ACCESS_TOKEN=seu_access_token
